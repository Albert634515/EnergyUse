<Window x:Class="WpfUI.Views.Windows.PredefinedPeriodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:WpfUI.Views.Controls"
        Title="Predefined Periods"
        Width="900" Height="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/add_24x24.png" Width="20"/>
                    <TextBlock Text="Add" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/tick-mark_24x24.png" Width="20"/>
                    <TextBlock Text="Save" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/clear_24x24.png" Width="20"/>
                    <TextBlock Text="Cancel" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/delete_24x24.png" Width="20"/>
                    <TextBlock Text="Delete" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/clock_24x24.png" Width="20"/>
                    <TextBlock Text="Refresh" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding CloseCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/crossed_24x24.png" Width="20"/>
                    <TextBlock Text="Close" Margin="5 0 0 0"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <StackPanel Margin="10">

            <TextBlock Text="Predefined Periods"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <DataGrid ItemsSource="{Binding PredefinedPeriods}"
                      SelectedItem="{Binding SelectedPeriod}"
                      AutoGenerateColumns="False"
                      Height="250"
                      Margin="0,0,0,20">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Start Date"
                                        Binding="{Binding StartDate, StringFormat=\{0:dd-MM-yyyy\}}"
                                        IsReadOnly="True"
                                        Width="140"/>
                    <DataGridTextColumn Header="End Date"
                                        Binding="{Binding EndDate, StringFormat=\{0:dd-MM-yyyy\}}"
                                        IsReadOnly="True"
                                        Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Period Dates"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <uc:DatePredefinedControl
                DataContext="{Binding DatePredefinedVM}" />

        </StackPanel>

    </DockPanel>

</Window>
