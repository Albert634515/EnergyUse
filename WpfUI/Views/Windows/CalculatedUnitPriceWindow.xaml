<Window x:Class="WpfUI.Views.Windows.CalculatedUnitPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculated Unit Price" Height="500" Width="800"
        MinHeight="350" MinWidth="650" ShowInTaskbar="False">
    <DockPanel x:Name="ContentPanel">
        <ToolBar DockPanel.Dock="Top">
            <Button Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/add_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Add" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/tick-mark_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Save" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/clear_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Cancel" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Delete_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/delete_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Delete" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/clock_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Refresh" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/crossed_24x24.png" Width="20" Height="20"/>
                    <TextBlock Text="Close" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
        </ToolBar>
        <Grid DockPanel.Dock="Top" Margin="10,10,10,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Energy type:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="EnergyTypes" Grid.Column="1" DisplayMemberPath="Name"
                      SelectionChanged="Filter_SelectionChanged"/>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="Select an energy type to manage yearly unit prices."
                   Margin="10" TextWrapping="Wrap"/>
        <DataGrid x:Name="Prices" Margin="10,0,10,0" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Year" Width="*"
                                    Binding="{Binding Year, ValidatesOnExceptions=True}"/>
                <DataGridTextColumn Header="Price per unit" Width="2*"
                                    Binding="{Binding Price, ValidatesOnExceptions=True}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
