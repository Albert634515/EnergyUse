<UserControl x:Class="WpfUI.Views.Controls.ChartRatesLiveChartsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Kostencategorie:" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="Type:" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Period:" FontWeight="SemiBold"/>

            <ComboBox Grid.Row="1" Grid.Column="0"
                      ItemsSource="{Binding CostCategoryOptions}"
                      Text="{Binding SelectedCostCategoriesText, Mode=OneWay}"
                      IsEditable="True"
                      IsReadOnly="True"
                      StaysOpenOnEdit="True"
                      Height="51"
                      Width="205">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Rate" GroupName="RatesShowType" IsChecked="{Binding ShowTypeRate}" Margin="0,0,12,0"/>
                <RadioButton Content="Unit" GroupName="RatesShowType" IsChecked="{Binding ShowTypeUnit}"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="2" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Van:" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding FromDate}" Width="130"/>
                <TextBlock Grid.Row="1" Text="Tot:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding TillDate}" Width="130" Margin="0,5,0,0"/>
            </Grid>

            <CheckBox Grid.Row="1" Grid.Column="3" Content="Punten per maand" IsChecked="{Binding ShowMonthlyDataPoints}" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1" Grid.Column="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Content="Reset" Width="90" Command="{Binding ResetCommand}" Margin="0,0,0,5"/>
                <Button Content="Export" Width="90" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="10">
            <lvc:CartesianChart
                Series="{Binding ChartSeries}"
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}"/>
        </Border>
    </Grid>
</UserControl>
